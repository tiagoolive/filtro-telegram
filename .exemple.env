# Configurações da API do Telegram (Userbot)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Telefone (opcional - se não preenchido, o terminal solicitará no primeiro login)
# TELEGRAM_PHONE=+5511999999999

# Destino das mensagens filtradas:
# "me" = Mensagens Salvas (Saved Messages) do próprio Telegram (padrão)
# Ou informe o ID/username de um canal/chat (ex: -100123456789 ou @meucanalalerta)
TARGET_CHAT=me

# Token do Bot Notificador (@BotFather) - Opcional, mas RECOMENDADO para alertas sonoros:
# TELEGRAM_BOT_TOKEN=
